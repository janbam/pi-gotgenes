{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-autoformat/main/schemas/pi-autoformat.schema.json",
  "formatters": {
    "invisible-characters": {
      "command": ["node", "scripts/lint/invisible-characters.mjs", "--fix"]
    },
    "biome": {
      "command": [
        "pnpm",
        "exec",
        "biome",
        "check",
        "--write",
        "--files-ignore-unknown=true"
      ]
    },
    "rumdl": {
      "command": ["pnpm", "exec", "rumdl", "fmt"]
    }
  },
  "chains": {
    ".ts": ["invisible-characters", "biome"],
    ".json": ["invisible-characters", "biome"],
    ".md": ["invisible-characters", "rumdl"]
  }
}
